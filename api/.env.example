# Copy to .env and fill in. NEVER commit .env (spec §9).

# PostgreSQL connection string
DATABASE_URL=postgres://etsy:etsy@localhost:5432/etsy_tracker

# HTTP server
HOST=0.0.0.0
PORT=8080

# Max records accepted in a single ingest batch
MAX_BATCH=500

# Local live demo: parse automatically after each ingest so the dashboard
# (http://localhost:8080) updates as you browse Etsy. Off by default.
AUTO_PARSE=true

# Optional key protecting the read-only dashboard. Empty = open (local only).
# When set, open the dashboard as http://localhost:8080/?key=<value>
DASHBOARD_KEY=

# Per-VPS ingestion tokens as JSON: { "<shop_tag>": "<token>", ... }
# One unique token per shop. A leaked token only affects that one shop.
# Generate tokens with: node -e "console.log('tok_'+require('crypto').randomBytes(24).toString('hex'))"
INGEST_TOKENS={"my-shop-01":"tok_replace_me_0123456789abcdef","shop-02":"tok_replace_me_fedcba9876543210"}
