{
  "manifest_version": 3,
  "name": "Etsy Shop Agent",
  "version": "2.0.4",
  "description": "Etsy mağaza ajanı: Etsy Ads ve Stats verisini komuta merkezine raporlar, onaylanan reklam talimatlarını uygular.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "userScripts"
  ],
  "host_permissions": [
    "https://www.etsy.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "minimum_chrome_version": "120",
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "update_url": "https://magaza-crm.fly.dev/ext/updates.xml",
  "key": ""
}