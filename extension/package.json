{
  "name": "etsy-shop-tracker-extension",
  "version": "1.0.0",
  "private": true,
  "description": "MV3 Chrome extension that captures Etsy internal JSON API responses via fetch/XHR interception (Phase 1).",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "test:e2e": "node e2e/interception.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "esbuild": "^0.21.5",
    "playwright-core": "^1.48.2",
    "typescript": "^5.5.4"
  }
}
