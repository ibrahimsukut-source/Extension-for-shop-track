{
  "manifest_version": 3,
  "name": "Etsy Shop Tracker",
  "version": "1.0.0",
  "description": "Captures Etsy internal JSON API responses (stats, messages, ads, listings, orders) for centralized multi-shop analytics.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://www.etsy.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.etsy.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.etsy.com/*"],
      "js": ["bridge.js", "actions.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
